require 'base64'

default_platform(:ios)

platform :ios do
  lane :build_and_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: Base64.decode64(ENV["ASC_PRIVATE_KEY_B64"]),
    )

    keychain_name = "build.keychain"
    keychain_password = "build_password"
    keychain_path = "#{Dir.home}/Library/Keychains/#{keychain_name}-db"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # app_store_connect_api_key Spaceship'i authenticate eder.
    # Mevcut Distribution sertifikalarını sil ki limit aşılmasın.
    UI.message("Deleting old Distribution certificates...")
    require 'spaceship'
    existing_certs = Spaceship::ConnectAPI::Certificate.all(
      filter: { certificateType: "IOS_DISTRIBUTION" }
    )
    UI.message("Found #{existing_certs.count} certificate(s)")
    existing_certs.each do |cert|
      UI.message("Deleting: #{cert.id}")
      cert.delete!
    end

    # Yeni Distribution sertifikası oluştur
    cert(
      api_key: api_key,
      output_path: "/tmp/certs",
      keychain_path: keychain_path,
      keychain_password: keychain_password,
    )

    # App Store Distribution provisioning profile indir/oluştur
    sigh(
      api_key: api_key,
      app_identifier: "com.alp.indirimRadari",
      output_path: "/tmp/profiles",
    )

    profile_uuid = lane_context[SharedValues::SIGH_UUID]
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # Projeyi manual signing + doğru profil ile güncelle
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "8J5Q5D5DB9",
      bundle_identifier: "com.alp.indirimRadari",
      code_sign_identity: "iPhone Distribution",
      profile_uuid: profile_uuid,
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=8J5Q5D5DB9 PROVISIONING_PROFILE='#{profile_uuid}' CODE_SIGN_IDENTITY='iPhone Distribution'",
      export_options: {
        method: "app-store",
        teamID: "8J5Q5D5DB9",
        signingStyle: "manual",
        provisioningProfiles: {
          "com.alp.indirimRadari" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
