require 'base64'

default_platform(:ios)

platform :ios do
  lane :build_and_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: Base64.decode64(ENV["ASC_PRIVATE_KEY_B64"]),
    )

    # xcodebuild -allowProvisioningUpdates için API key'i dosyaya yaz
    auth_key_path = "/tmp/AuthKey_#{ENV['ASC_KEY_ID']}.p8"
    File.write(auth_key_path, Base64.decode64(ENV["ASC_PRIVATE_KEY_B64"]))

    # Xcode projesini automatic signing moduna al
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "Runner.xcodeproj",
      team_id: "8J5Q5D5DB9",
      bundle_identifier: "com.alp.indirimRadari",
    )

    # -allowProvisioningUpdates: sertifika limiti dolunca eskisini silip yenisini oluşturur
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{auth_key_path} -authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        teamID: "8J5Q5D5DB9",
        signingStyle: "automatic",
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
