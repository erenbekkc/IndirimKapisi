require 'base64'

default_platform(:ios)

platform :ios do
  lane :build_and_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: Base64.decode64(ENV["ASC_PRIVATE_KEY_B64"]),
    )

    keychain_name = "build.keychain"
    keychain_password = "build_password"
    keychain_path = "#{Dir.home}/Library/Keychains/#{keychain_name}-db"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Eski Distribution sertifikalarını API ile sil
    UI.message("Cleaning up old Distribution certificates...")
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: {
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      text: Base64.decode64(ENV["ASC_PRIVATE_KEY_B64"])
    })
    old_certs = Spaceship::ConnectAPI::Certificate.all(
      filter: { certificateType: "IOS_DISTRIBUTION" }
    )
    old_certs.each do |cert|
      UI.message("Deleting old certificate: #{cert.name} (#{cert.id})")
      cert.delete!
    end

    # Yeni sertifika oluştur
    get_certificates(
      api_key: api_key,
      output_path: "/tmp/certs",
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.alp.indirimRadari",
      output_path: "/tmp/profiles"
    )

    profile_uuid = lane_context[SharedValues::SIGH_UUID]
    profile_name = lane_context[SharedValues::SIGH_NAME]

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=8J5Q5D5DB9 CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE='#{profile_uuid}'",
      export_options: {
        teamID: "8J5Q5D5DB9",
        signingStyle: "manual",
        provisioningProfiles: {
          "com.alp.indirimRadari" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
